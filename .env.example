# =========================================================
# FIREBASE CONFIGURATION
# =========================================================
#
# Copy this file to .env and populate with your Firebase project credentials.
#
# SECURITY: DO NOT commit .env to version control.
#           Add .env to .gitignore - it should only exist locally and in
#           secure deployment environments with proper CI/CD secrets management.
#
# SETUP: Get these values from Firebase Console:
#        1. Go to https://console.firebase.google.com
#        2. Select your SneakersLink project
#        3. Click "Project Settings" (gear icon)
#        4. Copy values from the "Your apps" section
#
# MODULES: These values are used by:
#          - firebase-config.js (Firebase project initialization)
#          - firebase-auth.js (Customer login, registration, password reset)
#          - firebase-profile.js (User profile management, avatar storage)
#          - firebase-orders.js (Order management in Firestore)
#
# FIREBASE SECURITY: API keys are PUBLIC by design (client-side apps need them).
#                    Real security is enforced by Firestore rules and Firebase
#                    Storage rules. See SETUP.md for proper security configuration.
# =========================================================

# Your Firebase Web API Key
# Found in: Firebase Console > Project Settings > General > Web API Key
VITE_FIREBASE_API_KEY=your_api_key_here

# Your Firebase project authentication domain
# Format: your-project.firebaseapp.com
# Found in: Firebase Console > Project Settings > General > Auth Domain
VITE_FIREBASE_AUTH_DOMAIN=your_auth_domain_here

# Your Firebase project ID
# Format: my-project-name or my-project-name-abc123
# Found in: Firebase Console > Project Settings > General > Project ID
VITE_FIREBASE_PROJECT_ID=your_project_id_here

# Your Firebase Cloud Storage bucket for profile images and order receipts
# Format: your-project.appspot.com
# Found in: Firebase Console > Storage > Bucket
VITE_FIREBASE_STORAGE_BUCKET=your_storage_bucket_here

# Firebase Cloud Messaging (FCM) sender ID (for push notifications)
# Format: numeric ID like 906549881554
# Found in: Firebase Console > Project Settings > General > Messaging Sender ID
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id_here

# Your Firebase app ID for this web application
# Format: 1:123456789:web:abc123def456
# Found in: Firebase Console > Project Settings > General > App ID
VITE_FIREBASE_APP_ID=your_app_id_here
